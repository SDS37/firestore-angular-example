{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": [
    {
      "target": "firebase-example-app",
      "public": "dist/firebase-example-app/browser",
      "ignore": [
        "firebase.json",
        ".firebaserc",
        ".git",
        ".gitignore",
        ".editorconfig",
        "firestore.rules",
        "firestore.indexes.json",
        "package.json",
        "README.md",
        "tsconfig.json",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ],
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
